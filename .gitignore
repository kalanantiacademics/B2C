# Ignore everything by default.
*

# Keep this ignore file tracked.
!.gitignore
!404.html
!knowledge-scl.md

# Allow curriculum folders
!level1/
!level1/**
!level2/
!level2/**
!level3/
!level3/**
!level4/
!level4/**

