# Ignore everything by default.
*

# Keep this ignore file tracked.
!.gitignore
!404.html

# Legacy dashboards under student-centered are intentionally ignored.
!student-centered/
!student-centered/panduan-scl-cabang.html

*.py

!student-centered/book-editor-slides/
!student-centered/book-editor-slides/**
student-centered/book-editor-slides/venv/
student-centered/book-editor-slides/__pycache__/
student-centered/book-editor-slides/server.log

# Track trial-new folder
!trial-new/
!trial-new/**

# Track outer folders
!student-dashboards/
!student-dashboards/**
!teacher-dashboard/
!teacher-dashboard/**

# Keep the active placement test implementation and its local visual assets.
!placement-test/
placement-test/*
!placement-test/*.html
!placement-test/*.js
!placement-test/*.mjs
!placement-test/*.py
!placement-test/*.gs
!placement-test/*.json
!placement-test/*.md
!placement-test/assets/
!placement-test/assets/**

knowledge-scl.md
